@model UniGuide.Models.Question

@{
    ViewData["Title"] = "Question Details";
}

<div class="container mt-4">

    <!-- Question Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <span class="badge bg-light text-primary me-2">@Model.Category</span>
            <span>Asked by @Model.UserName · @Model.CreatedAt.ToString("MMM dd, yyyy")</span>
        </div>
        <div class="card-body">
            <h3>@Model.Title</h3>
            <p class="mt-3">@Model.Description</p>
        </div>
    </div>

    <!-- Answers Section -->
    <h4 class="mb-3">💬 Answers (@Model.Answers.Count)</h4>

    <!-- Answer Form - College Students Only -->
    @if (User.IsInRole("College"))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">✍️ Write an Answer</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Question/AddAnswer">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="questionId" value="@Model.Id" />
                    <div class="mb-3">
                        <textarea name="content" class="form-control" rows="4"
                              placeholder="Write your answer here..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-success">
                        Submit Answer
                    </button>
                </form>
            </div>
        </div>
    }

    <!-- Answers List -->
    @if (Model.Answers.Count == 0)
    {
        <div class="alert alert-info">
            No answers yet.
            @if (!User.IsInRole("College"))
            {
                <span>Only college students can answer questions.</span>
            }
        </div>
    }
    else
    {
        @foreach (var answer in Model.Answers.OrderByDescending(a => a.CreatedAt))
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <p>@answer.Content</p>
                    <hr />
                    <small class="text-muted">
                        Answered by <strong>@answer.UserName</strong>
                        @if (!string.IsNullOrEmpty(answer.Major))
                        {
                            <span> · Major: @answer.Major</span>
                        }
                        · @answer.CreatedAt.ToString("MMM dd, yyyy")
                    </small>
                </div>
            </div>
        }
    }

    <a href="/" class="btn btn-outline-secondary mt-3">← Back to Home</a>
</div>