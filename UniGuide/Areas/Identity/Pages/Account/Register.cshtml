@page
@model UniGuide.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">📝 Create Account</h4>
                </div>
                <div class="card-body">

                    @if (Model.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }

                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Full Name</label>
                            <input name="FullName" class="form-control"
                                   placeholder="Enter your full name" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input name="Email" type="email" class="form-control"
                                   placeholder="Enter your email" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Password</label>
                            <input name="Password" type="password" class="form-control"
                                   placeholder="Enter your password" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">I am a:</label>
                            <select name="Role" class="form-select" required
                                    onchange="toggleMajor(this.value)">
                                <option value="">-- Select Role --</option>
                                <option value="HighSchool">High School Student</option>
                                <option value="College">College Student</option>
                            </select>
                        </div>

                        <div class="mb-3" id="majorDiv" style="display:none">
                            <label class="form-label fw-bold">Major</label>
                            <input name="Major" class="form-control"
                                   placeholder="e.g. Computer Science, Medicine..." />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                Register
                            </button>
                        </div>
                    </form>

                    <div class="mt-3 text-center">
                        <a href="/Identity/Account/Login">Already have an account? Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleMajor(role) {
        const majorDiv = document.getElementById('majorDiv');
        majorDiv.style.display = role === 'College' ? 'block' : 'none';
    }
</script>
